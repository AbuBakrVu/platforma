# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Домен сайта
APP_DOMAIN=learn.example.ru

# База (контейнер db, наружу не открыт)
POSTGRES_DB=platforma
POSTGRES_USER=platforma
POSTGRES_PASSWORD=change-me-long-random

# Где слушает приложение на хосте. 127.0.0.1 — только для локального nginx/traefik.
APP_BIND=127.0.0.1
APP_PORT=3100

# Часовой пояс расписания
APP_TZ=Europe/Moscow

# true за HTTPS-прокси; false — если открываете по http (только для теста)
COOKIE_SECURE=true

# caddy — встроенный HTTPS (если на сервере нет своего nginx/traefik и свободны 80/443)
# office — просмотр Word/PowerPoint/Excel в браузере (контейнер Gotenberg, ~1,5 ГБ)
# labs — лаборатории с терминалом (нужен docker.sock, см. README). Несколько — через запятую: caddy,office,labs
COMPOSE_PROFILES=
# При профиле office: http://gotenberg:3000
CONVERTER_URL=

# Лаборатории (профиль labs): секрет между приложением и сервисом, адрес сервиса, порт для /lab-ws/
LAB_RUNNER_URL=
LAB_SECRET=
LAB_PORT=3200
LAB_MAX_SESSIONS=20

# Максимальный размер загружаемого файла (видео), МБ
MAX_UPLOAD_MB=4096

# 1 — заполнить пустую базу демо-данными при первом запуске
SEED_DEMO=0
SEED_DEMO_PASSWORD=
